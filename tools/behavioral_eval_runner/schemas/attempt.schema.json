{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aegis-ber://schemas/attempt/1.0.0-wp2b1",
  "title": "Behavioral Eval Runner attempt record (WP-2B-1)",
  "description": "Immutable per-attempt record. Identity = (run_id, case_uid, repetition_number). UNRUN means exactly 'this planned attempt was NOT run' and is the default state of every planned attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "case_uid", "repetition_number", "attempt_state", "schema_version"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "case_uid": {"type": "string", "pattern": "^[^:]+::(behavior_eval|trigger_eval|conversation_suite)::[^:]+::[0-9a-f]{64}$"},
    "repetition_number": {"type": "integer", "minimum": 1},
    "attempt_state": {"enum": ["PASS", "FAIL", "ERROR", "JUDGE_ERROR", "UNRUN"]},
    "error_reason_code": {
      "anyOf": [
        {"type": "null"},
        {"enum": ["AMBIGUOUS_ACTIVATION", "MISSING_PREREQUISITE", "MISSING_FIXTURE", "FIXTURE_SETUP_FAILED", "INCOMPATIBLE_INVOCATION_MODE", "UNJUDGEABLE_ASSERTION", "BUDGET_CAP", "EVIDENCE_INTEGRITY_FAILURE", "LIVE_DISPATCH_DISABLED", "NOT_SELECTED"]}
      ]
    },
    "model_runtime_id": {"type": ["string", "null"]},
    "activation_evidence": {"type": ["object", "null"]},
    "assertion_results": {"type": "array", "items": {"type": "object"}},
    "cost_usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reserved_max": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "actual": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "released": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "monetary": {"anyOf": [{"const": "UNKNOWN"}, {"type": "integer", "minimum": 0}]}
      }
    },
    "duration_seconds": {"type": ["number", "null"], "minimum": 0},
    "evidence_pointer": {"type": ["string", "null"]},
    "schema_version": {"const": "1.0.0-wp2b1"}
  }
}
