{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aegis-ber://schemas/scenario-a-grading-plan/1.0.0-wp2b2",
  "title": "Trusted Scenario A grading plan (WP-2B-2, R2)",
  "description": "The versioned, immutable, hash-bound TRUSTED context a deterministic grader grades against. Plans are control-plane material, distinct from observed evidence: observations can neither contain nor override plan fields, plan_sha256 binds the content, contract_sha256 binds the plan to the grading contract it was authored against, and required_oracle_ids must equal the contract's set for the control.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "plan_version", "case_uid", "control_id", "contract_version", "contract_sha256", "required_oracle_ids", "trusted_source_refs", "expected_target", "answer_bank", "required_start_state", "loop_threshold", "required_gate_ids", "semantic_gates", "expected_final_ids", "expected_workspace_role", "expected_stage_zero", "schema_version", "plan_sha256"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "plan_version": {"const": "1.0.0-wp2b2"},
    "case_uid": {"type": "string", "pattern": "^[^:]+::(behavior_eval|trigger_eval|conversation_suite)::[^:]+::[0-9a-f]{64}$"},
    "control_id": {"type": "string", "pattern": "^SCENARIO_A_CONTROL_[A-Q]$"},
    "contract_version": {"const": "1.0.0-wp2b2"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_oracle_ids": {"type": "array", "items": {"enum": ["oracle.state_machine.transitions", "oracle.approval.boundary", "oracle.mutation.category_scan", "oracle.mutation.zero_commit", "oracle.append_only.version_sequence", "oracle.hashing.preview_vs_created", "oracle.activation.typed_target", "oracle.controls.workspace_role", "oracle.controls.stage_zero", "oracle.controls.questionnaire_dump", "oracle.controls.evidence_capture", "oracle.controls.metadata_capture"]}},
    "trusted_source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_target": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_kind", "target_name", "invocation_mode"],
          "properties": {
            "target_kind": {"enum": ["skill", "subagent"]},
            "target_name": {"type": "string", "minLength": 1},
            "invocation_mode": {"enum": ["model_selected", "explicit_skill_invocation", "delegated_subagent"]}
          }
        }
      ]
    },
    "answer_bank": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bank_id", "version", "sha256", "answer_ids"],
          "properties": {
            "bank_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "answer_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "required_start_state": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^STEP_[0-9]{2}$"}]},
    "loop_threshold": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 2}]},
    "required_gate_ids": {"anyOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]},
    "semantic_gates": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_acceptance_id", "spec_owner_completion_id", "stage2_owner_ids", "stage3_snapshot_id", "forbidden_snapshot_ids"],
          "properties": {
            "spec_acceptance_id": {"type": "string", "minLength": 1},
            "spec_owner_completion_id": {"type": "string", "minLength": 1},
            "stage2_owner_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "stage3_snapshot_id": {"type": "string", "minLength": 1},
            "forbidden_snapshot_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "expected_final_ids": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "State snapshots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "Decision log": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "Approvals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "expected_workspace_role": {"anyOf": [{"type": "null"}, {"enum": ["consumer", "source_library"]}]},
    "expected_stage_zero": {"type": ["boolean", "null"]},
    "schema_version": {"const": "1.0.0-wp2b2"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
