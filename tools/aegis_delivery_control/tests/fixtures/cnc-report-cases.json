  "contract_utf8": "{\n  \"schemaVersion\": 2,\n  \"id\": \"cnc-evidence-contract-v2\",\n  \"status\": \"Local evidence/coordination contract; not repository policy\",\n  \"scope\": \"Common vocabulary and evidence bookkeeping only. Each project owns all workflow, approval, model, concurrency, review, merge and production rules.\",\n  \"precedence\": \"Follow applicable direct owner authority and the project's own precedence rules. Locate and reconcile the exact conflicting scope; never transfer another project's grant or apply a universal strictest-text rule.\",\n  \"progress\": [\n    \"acknowledgment\",\n    \"substantive_answer\",\n    \"execution_milestone\",\n    \"accepted_completion\"\n  ],\n  \"evidenceLabels\": [\n    \"Observed\",\n    \"Reported\",\n    \"Inferred\",\n    \"Planned\",\n    \"UNRUN\",\n    \"Unknown\",\n    \"Historical\"\n  ],\n  \"recordFields\": [\n    \"project\",\n    \"task\",\n    \"source\",\n    \"sourceSHA256\",\n    \"retrievedAt\",\n    \"firstObservedAt_or_unknown\",\n    \"responsibleActor\",\n    \"scope\",\n    \"authority_original_locator\",\n    \"authority_confidence\",\n    \"candidate_identity\",\n    \"dependencies_and_holds\",\n    \"owner_notification_delivery_evidence\",\n    \"coordinator_answer\",\n    \"execution_evidence\",\n    \"accepted_completion_scope\",\n    \"next_action\",\n    \"next_check_or_due_reason\"\n  ],\n  \"failureKinds\": [\n    \"permission\",\n    \"access\",\n    \"evidence\",\n    \"technical_failure\"\n  ],\n  \"inheritFromProject\": [\n    \"canonical_board_and_designated_writer\",\n    \"applicable_authority_and_exceptions\",\n    \"stages_and_role_independence\",\n    \"model_routing_and_agent_cap\",\n    \"one_PR_submission_and_CI_serialization\",\n    \"review_and_provider_dispositions\",\n    \"exact_head_and_freshness_rules\",\n    \"skills_receipt_format\",\n    \"merge_backend_effects_and_postmerge_verification\"\n  ],\n  \"findingRule\": \"Use native dispositions. Late relevant findings must be assessed; workflow success is not a disposition. Duplicate/superseded findings point to their primary evidence. No C&C blocker whitelist, risk waiver, review cutoff or extra merge hold is created.\",\n  \"changeRule\": \"Identify changed inputs and the checks that consume them. A receipt-only change needs accurate readback and any native receipt checks, not an automatic full audit. Candidate head/scope/material findings route to native policy; mandatory exact-head, independence and freshness conditions remain.\",\n  \"authorityRule\": \"Verified applicable grants are reused without reapproval. A missing original is an authority-reconciliation gap, not proof the owner withheld permission. Preparation, risk acceptance, merge, hosted execution and publication remain separate.\",\n  \"partialEvidenceRule\": \"An inbox window is scoped complete:false; no deletion inference outside it or full-baseline overwrite. Keep manual versus heartbeat provenance truthful.\",\n  \"metrics\": {\n    \"unit\": \"Identify artifact review versus accepted product delivery; do not mix denominators\",\n    \"eventFields\": [\n      \"event_id\",\n      \"project\",\n      \"event_type\",\n      \"artifact_or_delivery_identity\",\n      \"source_and_hash\",\n      \"authorized_start_or_unknown\",\n      \"first_observed\",\n      \"last_observed\",\n      \"acceptance_and_scope\",\n      \"wall_window_basis\",\n      \"active_effort_or_unknown\",\n      \"quality_or_rework\",\n      \"cost_provenance\"\n    ],\n    \"comparison\": \"Speed comparison requires matched work definitions, boundaries and quality/coverage. Cost savings requires comparable attributed costs including coordination/rework. ROI requires attributable benefit and full incremental cost, with uncertainty disclosed.\",\n    \"missing\": \"Unknown is null with a reason, never inferred zero. Quotes, reservations, reported usage, estimated price and invoices remain separate.\",\n    \"speedFormula\": \"(matched_baseline_elapsed - current_elapsed) / matched_baseline_elapsed; undefined without comparable baseline\",\n    \"savingsFormula\": \"matched_baseline_attributed_cost - current_attributed_cost; undefined without comparable cost\",\n    \"roiFormula\": \"(attributable_benefit - incremental_cost) / incremental_cost; undefined when inputs are missing or denominator is nonpositive\",\n    \"sampling\": \"Capture existing delivery/review receipts once; no extra provider run, schedule, duplicate board or metrics-only PR.\",\n    \"reportTrigger\": \"Retain the local 30-day or 10 accepted-product-delivery review target. While timer is paused, no scheduled collection occurs. Manual authorized outcomes can append evidence.\"\n  },\n  \"notAuthority\": [\n    \"No executing agent, reviewer or merger is dispatched by this contract\",\n    \"No product readiness can be inferred from passing helper checks\",\n    \"No source/consumer adoption or money saving is inferred from these files\"\n  ]\n}\n",
