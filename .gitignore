# Local clone of the owner-only calibration input repository.
.private-calibration-inputs/

# Python bytecode caches created by running the validators and tests.
__pycache__/
*.pyc

# Reserved local scratch path for the resumable control plane. Recommended in
# later authorized work by docs/design/resumable-control-plane-v1.md; the other
# two patterns it recommends are already covered above by `__pycache__/` and
# `*.pyc`.
/.aegis-control-plane/

# Git worktrees live inside the checkout (CONTRIBUTING.md: "Use isolated
# worktrees for separate changes"). They are checkouts of code already tracked
# here, so nothing under them is unique source. Without this rule, one
# reflexive `git add -A` stages the whole .worktrees tree and embeds a nested
# repository as a broken gitlink.
/.worktrees/
