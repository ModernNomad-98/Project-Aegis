{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ModernNomad-98/Project-Aegis/docs/instrumentation/workflow-outcomes-v1.schema.json",
  "title": "Aegis workflow outcomes, version 1",
  "description": "Strict, minimized workflow-outcome snapshot. No identities, prompts, output or code, project/repository/path names, content hashes or free text. Every string is an allowlisted enum, a day-precision date or a random reference. additionalProperties is false at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "library_revision",
    "capture_tier",
    "consent_policy_version",
    "reporting_window_days",
    "admission_ref",
    "snapshot"
  ],
  "properties": {
    "schema": {
      "const": "workflow-outcomes-v1"
    },
    "library_revision": {
      "enum": [
        "1.0.0"
      ]
    },
    "capture_tier": {
      "const": "self_report"
    },
    "consent_policy_version": {
      "enum": [
        "1"
      ]
    },
    "reporting_window_days": {
      "const": 30
    },
    "admission_ref": {
      "type": "string",
      "pattern": "^adm-[0-9a-f]{32}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_ref",
        "revision",
        "export_ref",
        "start_day",
        "last_observed_day",
        "report_due_day",
        "applicable_stages",
        "criteria_frozen_before_work",
        "criteria_contract_ref",
        "stage_status",
        "status",
        "acceptance",
        "acceptance_evidence",
        "delivery_day",
        "acceptance_day",
        "transitions"
      ],
      "properties": {
        "workflow_ref": {
          "type": "string",
          "pattern": "^wf-[0-9a-f]{32}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "export_ref": {
          "type": "string",
          "pattern": "^exp-[0-9a-f]{32}$"
        },
        "start_day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "last_observed_day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "report_due_day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "applicable_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "discover",
              "plan",
              "build",
              "validate",
              "deliver"
            ]
          }
        },
        "criteria_frozen_before_work": {
          "type": "boolean"
        },
        "criteria_contract_ref": {
          "type": "string",
          "pattern": "^crit-[0-9a-f]{32}$"
        },
        "stage_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discover",
            "plan",
            "build",
            "validate",
            "deliver"
          ],
          "properties": {
            "discover": {
              "type": "string",
              "enum": [
                "not_started",
                "in_progress",
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "plan": {
              "type": "string",
              "enum": [
                "not_started",
                "in_progress",
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "build": {
              "type": "string",
              "enum": [
                "not_started",
                "in_progress",
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "validate": {
              "type": "string",
              "enum": [
                "not_started",
                "in_progress",
                "complete",
                "not_applicable",
                "unknown"
              ]
            },
            "deliver": {
              "type": "string",
              "enum": [
                "not_started",
                "in_progress",
                "complete",
                "not_applicable",
                "unknown"
              ]
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "ongoing",
            "delivered",
            "failed",
            "abandoned",
            "unknown"
          ]
        },
        "acceptance": {
          "type": "string",
          "enum": [
            "not_assessed",
            "self_reported_pass",
            "self_reported_fail",
            "independent_attested_pass",
            "independent_attested_fail"
          ]
        },
        "acceptance_evidence": {
          "type": "string",
          "enum": [
            "none",
            "local_checklist",
            "local_test_record",
            "local_review_record"
          ]
        },
        "delivery_day": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_day": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_ref",
              "kind",
              "effective_day",
              "value",
              "stage"
            ],
            "properties": {
              "event_ref": {
                "type": "string",
                "pattern": "^evt-[0-9a-f]{32}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "status",
                  "stage",
                  "acceptance",
                  "scope_change",
                  "observation"
                ]
              },
              "effective_day": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "value": {
                "type": "string",
                "enum": [
                  "delivered",
                  "failed",
                  "abandoned",
                  "not_started",
                  "in_progress",
                  "complete",
                  "not_applicable",
                  "unknown",
                  "not_assessed",
                  "self_reported_pass",
                  "self_reported_fail",
                  "independent_attested_pass",
                  "independent_attested_fail",
                  "criteria_changed",
                  "ongoing"
                ]
              },
              "stage": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "discover",
                      "plan",
                      "build",
                      "validate",
                      "deliver"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "status"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "delivered",
                        "failed",
                        "abandoned"
                      ]
                    },
                    "stage": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "stage"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "not_started",
                        "in_progress",
                        "complete",
                        "not_applicable",
                        "unknown"
                      ]
                    },
                    "stage": {
                      "enum": [
                        "discover",
                        "plan",
                        "build",
                        "validate",
                        "deliver"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "acceptance"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "not_assessed",
                        "self_reported_pass",
                        "self_reported_fail",
                        "independent_attested_pass",
                        "independent_attested_fail"
                      ]
                    },
                    "stage": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "scope_change"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "criteria_changed"
                      ]
                    },
                    "stage": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "observation"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "enum": [
                        "ongoing",
                        "unknown"
                      ]
                    },
                    "stage": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
