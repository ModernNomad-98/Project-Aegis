+def baseline_unwrap(lines: list[str]) -> tuple[list[str], list[list[tuple[int, int]]]]:
+    """Frozen pre-bound unwrapping oracle for small compatibility inputs only."""
+    import re
+
+    quote_marker = re.compile(r"^ {0,3}>[ \t]?")
+    block_start = re.compile(r"^ {0,3}(?:#{1,6}\s|`{3,}|~{3,}|[-*+][ \t]|\d+[.)][ \t]|>|<!--)")
+
+    def text_open(line: str) -> bool:
+        return line.rfind("[") > line.rfind("]")
+
+    def target_open(line: str) -> bool:
+        if "](" not in line:
+            return False
+        after = line[line.rfind("](") + 2:]
+        return line.rfind("[") > line.rfind("])") and (")" not in after or "(" in after)
+
+    merged: list[str] = []
+    spans: list[list[tuple[int, int]]] = []
+    index = 0
+    while index < len(lines):
+        current = lines[index]
+        positions = [(0, index + 1)]
+        while index + 1 < len(lines):
+            if not (text_open(current) or target_open(current)):
+                break
+            stripped = quote_marker.sub("", lines[index + 1])
+            if not stripped.strip() or block_start.match(stripped):
+                break
+            head = current.rstrip()
+            tail = stripped.strip()
+            current = head + " " + tail
+            positions.append((len(head) + 1, index + 2))
+            index += 1
+        merged.append(current)
+        spans.append(positions)
+        index += 1
+    return merged, spans
+
+
+def load_checker():
+    spec = importlib.util.spec_from_file_location("aegis_checker_under_test", CHECKER)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class UnwrapCompatibilityTests(unittest.TestCase):
