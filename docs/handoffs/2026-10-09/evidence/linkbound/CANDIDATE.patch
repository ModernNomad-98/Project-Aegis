+    def test_explicit_text_and_span_contract(self):
+        cases = (
+            ([], ([], [])),
+            (["plain"], (["plain"], [[(0, 1)]])),
+            (["[a", "b](c)"], (["[a b](c)"], [[(0, 1), (3, 2)]])),
+            (["[a", "b", "c](d)"], (["[a b c](d)"], [[(0, 1), (3, 2), (5, 3)]])),
+            (["[a \t", " b](c)"], (["[a b](c)"], [[(0, 1), (3, 2)]])),
+            (["[a](", "b)"], (["[a]( b)"], [[(0, 1), (5, 2)]])),
+            (["[a", "", "b](c)"], (["[a", "", "b](c)"], [[(0, 1)], [(0, 2)], [(0, 3)]])),
+            (["[a", "# Heading", "b](c)"], (["[a", "# Heading", "b](c)"], [[(0, 1)], [(0, 2)], [(0, 3)]])),
+            (["[a", "> b](c)"], (["[a b](c)"], [[(0, 1), (3, 2)]])),
+            (["[a", ">> b](c)"], (["[a", ">> b](c)"], [[(0, 1)], [(0, 2)]])),
+            (["[a", "- b](c)"], (["[a", "- b](c)"], [[(0, 1)], [(0, 2)]])),
+            (["[a", "<!-- x"], (["[a", "<!-- x"], [[(0, 1)], [(0, 2)]])),
+            (["See [ok](a) and [open", "tail](b)"],
+             (["See [ok](a) and [open tail](b)"], [[(0, 1), (22, 2)]])),
+            (["[a](x) [b", "c](y) [d", "e](z)"],
+             (["[a](x) [b c](y) [d e](z)"], [[(0, 1), (10, 2), (19, 3)]])),
+            (["] stray [b", "c](d)"], (["] stray [b c](d)"], [[(0, 1), (11, 2)]])),
+            (["[x](a) [y](", "b)"], (["[x](a) [y]( b)"], [[(0, 1), (12, 2)]])),
+            (["[x](a) [y]", "(b)"],
+             (["[x](a) [y]", "(b)"], [[(0, 1)], [(0, 2)]])),
+            (["[x](a)b(", "c)", "d"],
+             (["[x](a)b( c) d"], [[(0, 1), (9, 2), (12, 3)]])),
+            (["[x](", "a)b(", "c)"], (["[x]( a)b( c)"], [[(0, 1), (5, 2), (10, 3)]])),
+            (["[x](", "a)", "still"],
+             (["[x]( a)", "still"], [[(0, 1), (5, 2)], [(0, 3)]])),
+            (["[x\u2003", "\tname](target)"],
+             (["[x name](target)"], [[(0, 1), (3, 2)]])),
+            (["[x", "```", "y](z)"],
