+class BoundAndReportTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = Path(tempfile.mkdtemp(prefix="aegis-md-bound-"))
+        self.addCleanup(shutil.rmtree, self.directory, True)
+
+    def run_with_timeout(self, target: Path, *extra: str):
+        return subprocess.run([sys.executable, "-B", str(CHECKER), str(target), *extra],
+                              cwd=REPO, capture_output=True, text=True, timeout=15)
+
+    def test_large_join_and_boundary_keep_broken_tail_links(self):
+        count = 16384
+        continuation = ("a" * 64 + "\n") * count
+        doc = self.directory / "long.md"
+        doc.write_text("[x\n" + continuation +
+                       "](missing-tail.md) and [other](also-missing.md)\n", encoding="utf-8")
+        joined = self.run_with_timeout(doc)
+        self.assertEqual(1, joined.returncode, joined.stdout + joined.stderr)
+        self.assertIn("broken: 2", joined.stdout)
+        self.assertIn("long.md:1 -> missing-tail.md", joined.stdout)
+        self.assertIn("long.md:16386 -> also-missing.md", joined.stdout)
+        doc.write_text("[x\n" + continuation + "\n[tail](missing-tail.md)\n", encoding="utf-8")
+        boundary = self.run_with_timeout(doc)
+        self.assertEqual(1, boundary.returncode, boundary.stdout + boundary.stderr)
+        self.assertIn("broken: 1", boundary.stdout)
+        self.assertIn("long.md:16387 -> missing-tail.md", boundary.stdout)
+
+    def test_block_boundaries_do_not_absorb_a_later_link(self):
+        doc = self.directory / "boundary.md"
+        for boundary in ("", "# heading", "- item", "1. item", ">> nested", "<!-- comment"):
+            with self.subTest(boundary=boundary):
+                doc.write_text("Open [label\n" + boundary + "\n[real](missing.md)\n",
+                               encoding="utf-8")
+                result = self.run_with_timeout(doc)
+                self.assertEqual(1, result.returncode, result.stdout + result.stderr)
+                self.assertIn("broken: 1", result.stdout)
+                self.assertIn("boundary.md:3 -> missing.md", result.stdout)
+
+    def test_public_modes_and_mixed_classification(self):
+        doc = self.directory / "mixed.md"
+        (self.directory / "target.md").write_text("# Known\n", encoding="utf-8")
+        (self.directory / "asset.txt").write_text("asset\n", encoding="utf-8")
+        doc.write_text("\n".join((
+            "[good](target.md) [dir](.) [anchor](target.md#known)",
+            "[broken](missing.md) [dead](target.md#none)",
+            "[external](https://example.invalid/a) [site](/absolute)",
+            "[file fragment](asset.txt#x)", "")), encoding="utf-8")
+        normal = self.run_with_timeout(doc)
+        as_json = self.run_with_timeout(doc, "--json")
+        quiet = self.run_with_timeout(doc, "--quiet")
+        self.assertEqual((1, 1, 1), (normal.returncode, as_json.returncode, quiet.returncode))
+        self.assertEqual({"files": 1, "checked": 5, "anchors": 2, "broken": 1,
+                          "dead": 1, "external": 1, "skipped": 2}, json.loads(as_json.stdout))
+        self.assertIn("mixed.md:2 -> missing.md", normal.stdout)
+        self.assertIn("mixed.md:2 -> target.md#none", normal.stdout)
+        self.assertIn("external (not fetched)", normal.stdout)
+        self.assertEqual("", quiet.stdout)
+        missing = self.run_with_timeout(self.directory / "absent.md")
+        self.assertEqual(2, missing.returncode)
+        self.assertIn("BROKEN INPUT", missing.stdout)
