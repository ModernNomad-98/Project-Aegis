+    def test_frozen_oracle_on_seeded_punctuation_and_block_fragments(self):
+        seed = 103648
+        rng = random.Random(seed)
+        fragments = ("[", "]", "(", ")", "](", "])", "a", " ", "\t", "\u2003",
+                     "> ", ">> ", "# ", "```", "~" * 3, "- ", "1. ", "<!--", "\n")
+        for case in range(1200):
+            lines = ["".join(rng.choices(fragments, k=rng.randrange(0, 7)))
+                     for _ in range(rng.randrange(0, 9))]
+            with self.subTest(seed=seed, case=case, lines=lines):
+                self.assertEqual(baseline_unwrap(lines), self.checker.unwrap_links(lines))
+
+    def test_unwrap_runtime_is_linear_on_unclosed_shapes(self):
+        child = """
+import json, runpy, statistics, sys, time
+unwrap = runpy.run_path(sys.argv[1])['unwrap_links']
+shape = sys.argv[2]
+sizes = (4096, 8192, 16384)
+unwrap([shape] + ['a' * 64] * 256)
+samples = {}
+for n in sizes:
+    lines = [shape] + ['a' * 64] * n
+    times = []
+    for _ in range(3):
+        start = time.perf_counter()
+        result, spans = unwrap(lines)
+        times.append(time.perf_counter() - start)
+        assert len(result) == 1 and len(spans[0]) == n + 1
+    samples[n] = times
+print(json.dumps({'samples': samples, 'medians': {n: statistics.median(times) for n, times in samples.items()}}))
+"""
+        for shape in ("[x", "[x]("):
+            with self.subTest(shape=shape):
+                result = subprocess.run([sys.executable, "-B", "-c", child, str(CHECKER), shape],
+                                        cwd=REPO, capture_output=True, text=True, timeout=30)
+                self.assertEqual(0, result.returncode, result.stdout + result.stderr)
+                readings = json.loads(result.stdout)
+                medians = readings["medians"]
+                self.assertLessEqual(medians["16384"], 6 * medians["4096"] + 0.05, readings)
+                self.assertLess(medians["16384"], 5, readings)
