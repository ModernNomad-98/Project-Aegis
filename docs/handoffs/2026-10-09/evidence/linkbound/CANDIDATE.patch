+class _OpenLinkState:
+    """The rightmost markers used by the two wrap predicates, scanned once.
+
+    These are deliberately the predicates above, not a Markdown parser.  In
+    particular, any ``(`` after the latest ``](`` keeps a target open even if
+    a ``)`` also follows it.  Positions include the joining spaces.
+    """
+
+    def __init__(self) -> None:
+        self.length = 0
+        self.previous = ""
+        self.last_open = -1
+        self.last_close = -1
+        self.last_target = -1
+        self.last_closed_target = -1
+        self.target_has_open = False
+        self.target_has_close = False
+
+    def add(self, text: str) -> None:
+        for char in text:
+            position = self.length
+            if position > self.last_target + 1:
+                if char == "(":
+                    self.target_has_open = True
+                elif char == ")":
+                    self.target_has_close = True
+            if char == "[":
+                self.last_open = position
+            elif char == "]":
+                self.last_close = position
+            if self.previous == "]" and char == "(":
+                self.last_target = position - 1
+                self.target_has_open = False
+                self.target_has_close = False
+            elif self.previous == "]" and char == ")":
+                self.last_closed_target = position - 1
+            self.previous = char
+            self.length += 1
+
+    def open(self) -> bool:
+        return (self.last_open > self.last_close or
+                (self.last_target >= 0 and self.last_open > self.last_closed_target
+                 and (not self.target_has_close or self.target_has_open)))
+
