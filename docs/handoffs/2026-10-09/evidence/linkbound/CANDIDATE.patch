+            (["[x", "~~~", "y](z)"],
+             (["[x", "~~~", "y](z)"], [[(0, 1)], [(0, 2)], [(0, 3)]])),
+            (["[x", "* item", "y](z)"],
+             (["[x", "* item", "y](z)"], [[(0, 1)], [(0, 2)], [(0, 3)]])),
+            (["[x", "+ item", "y](z)"],
+             (["[x", "+ item", "y](z)"], [[(0, 1)], [(0, 2)], [(0, 3)]])),
+            (["[x", "1. item", "y](z)"],
+             (["[x", "1. item", "y](z)"], [[(0, 1)], [(0, 2)], [(0, 3)]])),
+            (["[x", "\t", "y](z)"],
+             (["[x", "\t", "y](z)"], [[(0, 1)], [(0, 2)], [(0, 3)]])),
