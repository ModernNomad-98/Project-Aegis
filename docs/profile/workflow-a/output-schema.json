{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aegis-profile://workflow-a/output-schema/1.0.0",
  "title": "Workflow A output object",
  "description": "One schema-valid object per synthetic support question. Design artifact only; no runtime produces it in this item. The schema admits an over-ceiling cost estimate so a cost_ceiling refusal can record the estimate that caused it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "answer",
    "citations",
    "claims",
    "confidence",
    "refusal_reason",
    "escalation_role",
    "escalation_reason",
    "cost_estimate",
    "corpus_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "answered",
        "refused",
        "escalated"
      ]
    },
    "answer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000,
      "description": "Answer text for status=answered; null for refused; optional summary for escalated."
    },
    "citations": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "description": "The union of all claim citations. The total cap is 24, and each claim entry may carry one to three of these citations.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{2,63}#[a-z0-9][a-z0-9-]*$"
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 12,
      "description": "Per-sentence citation mapping. Each entry names a factual sentence index and one to three indices into citations. Empty for refused.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sentence_index",
          "citation_indices"
        ],
        "properties": {
          "sentence_index": {
            "type": "integer",
            "minimum": 0
          },
          "citation_indices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "refusal_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "unsupported",
        "invalid_input",
        "schema_invalid",
        "citation_unresolved",
        "cost_ceiling",
        "out_of_scope",
        "prompt_injection",
        "instruction_bearing_source"
      ]
    },
    "escalation_role": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "policy-owner",
        "support-lead",
        "security-owner"
      ]
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "description": "Required and non-empty for status=escalated; null for answered and refused."
    },
    "security_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "rule"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}#[a-z0-9][a-z0-9-]*$"
          },
          "rule": {
            "enum": [
              "instruction_override",
              "tool_request",
              "workflow_change",
              "hidden_context"
            ]
          }
        }
      }
    },
    "cost_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "within_ceiling"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Unbounded non-negative estimate. Values above the 2,000-token design ceiling are valid so a cost_ceiling refusal can record the overrun."
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Unbounded non-negative estimate. Values above the 400-token design ceiling are valid so a cost_ceiling refusal can record the overrun."
        },
        "within_ceiling": {
          "type": "boolean"
        }
      }
    },
    "corpus_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "answered"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "minItems": 1
          },
          "claims": {
            "minItems": 1
          },
          "refusal_reason": {
            "const": null
          },
          "escalation_role": {
            "const": null
          },
          "escalation_reason": {
            "const": null
          },
          "confidence": {
            "minimum": 0.55
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "refused"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "answer": {
            "const": null
          },
          "citations": {
            "maxItems": 0
          },
          "claims": {
            "maxItems": 0
          },
          "refusal_reason": {
            "type": "string"
          },
          "escalation_role": {
            "const": null
          },
          "escalation_reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "escalated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "refusal_reason": {
            "const": null
          },
          "escalation_role": {
            "type": "string"
          },
          "escalation_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "comment": "A cost overrun must refuse before answering; an answer cannot carry within_ceiling=false.",
      "if": {
        "properties": {
          "cost_estimate": {
            "properties": {
              "within_ceiling": {
                "const": false
              }
            },
            "required": [
              "within_ceiling"
            ]
          }
        },
        "required": [
          "cost_estimate"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "refused"
          }
        }
      }
    }
  ]
}
